{
  "expo": {
    "name": "WLAN Warehouse",
    "slug": "wlan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-1.png",
      "resizeMode": "contain",
      "backgroundColor": "#1976D2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wlancorp.warehouse"
    },
    "android": {
      "package": "com.wlancorp.warehouse",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1976D2"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WLAN Warehouse to access your camera to scan QR codes and barcodes"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WLAN Warehouse to access your photos to upload product images"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "wlan-warehouse-mobile"
      }
    }
  }
}
