# Environment Configuration
EXPO_PUBLIC_ENV=development

# API Base URLs - Development
# For Android Emulator: Use 10.0.2.2 to connect to host machine's localhost
# For Physical Device: Replace with your machine's IP address (e.g., 192.168.1.100)
EXPO_PUBLIC_API_BASE_URL_AUTH=http://10.0.2.2:5001/api/v1
EXPO_PUBLIC_API_BASE_URL_PMS=http://10.0.2.2:5002/api/v1

# API Base URLs - Production (commented out for now)
# EXPO_PUBLIC_API_BASE_URL_AUTH=https://api.wlancorp.com/auth/api/v1
# EXPO_PUBLIC_API_BASE_URL_PMS=https://pms.wlancorp.com/api/v1

# App Configuration
APP_NAME=WLAN Warehouse
APP_VERSION=1.0.0

# Token Configuration
ACCESS_TOKEN_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000

# Features
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false

# Timeouts
API_TIMEOUT=30000
INACTIVITY_TIMEOUT=1800000
