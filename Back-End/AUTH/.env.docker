# Docker Environment Configuration
# This file is used by docker-compose.yml for containerized deployment

# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/auth_db?authSource=admin

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=wlan-auth-service
JWT_AUDIENCE=wlan-services

# Email Configuration
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=WLAN Corporation
EMAIL_FROM_ADDRESS=your-email@gmail.com

# CORS Configuration
# For credentials support (httpOnly cookies), use specific origins (not wildcard)
# Development: http://localhost:3000,http://localhost:4200
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Logging Configuration
LOG_TYPE=CONSOLE
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true

# File Upload
UPLOAD_DIR=uploads/profiles
MAX_FILE_SIZE=2097152
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
